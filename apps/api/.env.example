NODE_ENV=development
PORT=8000

CLIENT_URL=http://localhost:3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_interview?schema=public"

ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

RESEND_API_KEY=re_replace_me
# Use onboarding@resend.dev only when sending to the Resend account owner's email.
# For real users, replace this with an address on a domain verified in Resend.
EMAIL_FROM="AI Interview <onboarding@resend.dev>"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Register these exact callback URLs in the provider consoles for local development:
# Google: http://localhost:8000/api/v1/auth/oauth/google/callback
# GitHub: http://localhost:8000/api/v1/auth/oauth/github/callback

# Used only by `npm run bootstrap:super-admin --workspace=api`.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
