generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ================================
// ENUMS
// ================================

enum UserRole {
  CANDIDATE
  RECRUITER
  ORGANIZATION_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ExperienceLevel {
  FRESHER
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
}

enum AuthProvider {
  GOOGLE
  GITHUB
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ResumeStatus {
  PENDING_UPLOAD
  UPLOADED

  PARSING
  PARSED

  ANALYZING
  ANALYZED

  CHUNKING
  CHUNKED

  EMBEDDING
  READY

  FAILED
}

enum ResumeSection {
  SUMMARY
  SKILLS
  EXPERIENCE
  EDUCATION
  PROJECTS
  CERTIFICATIONS
  ACHIEVEMENTS
  LANGUAGES
  OTHER
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum JobApplicationStatus {
  APPLIED
  UNDER_REVIEW
  INTERVIEW_CREATED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  TECHNICAL
  BEHAVIORAL
  HR
  MIXED
}

enum InterviewDifficulty {
  EASY
  MEDIUM
  HARD
  ADAPTIVE
}

enum InterviewStatus {
  CREATED
  READY
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

enum InterviewQuestionType {
  TEXT
  CODING
  MCQ
  SYSTEM_DESIGN
}

enum InterviewQuestionSource {
  TEMPLATE
  RESUME
  JOB_DESCRIPTION
  AI_GENERATED
  FOLLOW_UP
}

enum InterviewInvitationStatus {
  PENDING
  SENT
  OPENED
  ACCEPTED
  REVOKED
  EXPIRED
}

enum NotificationType {
  JOB_AVAILABLE
  JOB_APPLICATION_RECEIVED
  JOB_APPLICATION_STATUS
  INTERVIEW_INVITATION
  INTERVIEW_REMINDER
  INTERVIEW_COMPLETED
  INTERVIEW_RESULT_READY
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum InterviewIntegrityEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY
  PASTE
  CUT
  PAGE_REFRESH
  DISCONNECT
  HEARTBEAT_MISSED
}

enum InterviewIntegritySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

// ================================
// USER
// ================================

model User {
  id String @id @default(uuid()) @db.Uuid

  name         String
  email        String  @unique
  passwordHash String?

  avatarUrl String?

  role   UserRole   @default(CANDIDATE)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?

  accounts                Account[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  invitationsSent         AccountInvitation[]      @relation("InvitationSender")
  notifications           Notification[]

  jobOpenings JobOpening[] @relation("JobOpeningCreatedBy")

  interviewTemplates InterviewTemplate[] @relation("InterviewTemplateCreatedBy")

  createdInterviews Interview[] @relation("InterviewCreatedBy")

  sentInterviewInvitations InterviewInvitation[] @relation("InterviewInvitationInvitedBy")

  receivedInterviewInvitations InterviewInvitation[] @relation("InterviewInvitationCandidate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([lockedUntil])
  @@map("users")
}

// ================================
// CANDIDATE PROFILE
// ================================

model CandidateProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid

  headline String?
  bio      String?

  currentRole String?
  targetRole  String?

  experienceYears Int              @default(0)
  experienceLevel ExperienceLevel?

  location String?

  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumes    Resume[]
  interviews Interview[]
  jobApplications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experienceLevel])
  @@map("candidate_profiles")
}

// ================================
// RECRUITER PROFILE
// ================================

model RecruiterProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid

  jobTitle   String?
  department String?
  bio        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recruiter_profiles")
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  provider          AuthProvider
  providerAccountId String

  accessToken  String?
  refreshToken String?

  tokenExpiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  refreshTokenHash String @unique

  status SessionStatus @default(ACTIVE)

  ipAddress String?
  userAgent String?

  deviceName String?

  expiresAt DateTime
  revokedAt DateTime?

  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId    String @db.Uuid
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AccountInvitation {
  id String @id @default(uuid()) @db.Uuid

  email String
  name  String
  role  UserRole

  tokenHash String @unique

  invitedById String @db.Uuid
  invitedBy   User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([invitedById])
  @@index([expiresAt])
  @@map("account_invitations")
}

model Resume {
  id String @id @default(uuid()) @db.Uuid

  candidateProfileId String @db.Uuid

  title String?

  originalFileName String
  mimeType         String
  fileSize         Int

  storageProvider String @default("imagekit")

  storageFileId String
  storagePath   String
  storageUrl    String?

  checksum String?

  status ResumeStatus @default(PENDING_UPLOAD)

  isPrimary Boolean @default(false)

  rawText   String? @db.Text
  pageCount Int?
  wordCount Int?

  extractedData Json?

  processingError String? @db.Text
  failureStage    String?

  uploadedAt DateTime?
  parsedAt   DateTime?
  analyzedAt DateTime?
  embeddedAt DateTime?

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  skills      ResumeSkill[]
  experiences ResumeExperience[]
  educations  ResumeEducation[]
  projects    ResumeProject[]
  chunks      ResumeChunk[]
  interviews  Interview[]
  jobApplications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateProfileId])
  @@index([candidateProfileId, createdAt])
  @@index([status])
  @@index([isPrimary])
  @@map("resumes")
}

model ResumeSkill {
  id String @id @default(uuid()) @db.Uuid

  resumeId String @db.Uuid

  name           String
  normalizedName String

  category String?

  yearsExperience Float?
  confidence      Float?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resumeId, normalizedName])
  @@index([resumeId])
  @@index([normalizedName])
  @@map("resume_skills")
}

model ResumeExperience {
  id String @id @default(uuid()) @db.Uuid

  resumeId String @db.Uuid

  company String
  role    String

  location String?

  employmentType String?

  startDate DateTime?
  endDate   DateTime?

  isCurrent Boolean @default(false)

  description String? @db.Text

  achievements String[] @default([])

  technologies String[] @default([])

  sortOrder Int @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@index([company])
  @@map("resume_experiences")
}

model ResumeEducation {
  id String @id @default(uuid()) @db.Uuid

  resumeId String @db.Uuid

  institution String

  degree String?
  field  String?

  location String?

  startDate DateTime?
  endDate   DateTime?

  grade String?

  description String? @db.Text

  sortOrder Int @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@index([institution])
  @@map("resume_educations")
}

model ResumeProject {
  id String @id @default(uuid()) @db.Uuid

  resumeId String @db.Uuid

  name String

  role String?

  description String? @db.Text

  projectUrl    String?
  repositoryUrl String?

  technologies String[] @default([])

  startDate DateTime?
  endDate   DateTime?

  sortOrder Int @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@index([name])
  @@map("resume_projects")
}

model ResumeChunk {
  id String @id @default(uuid()) @db.Uuid

  resumeId String @db.Uuid

  chunkIndex Int

  section ResumeSection @default(OTHER)

  text String @db.Text

  tokenCount Int?

  contentHash String?

  qdrantPointId String? @unique

  embeddingModel String?

  metadata Json?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resumeId, chunkIndex])
  @@index([resumeId])
  @@index([section])
  @@map("resume_chunks")
}

model JobOpening {
  id String @id @default(uuid()) @db.Uuid

  createdById String @db.Uuid

  title       String
  description String @db.Text

  department     String?
  location       String?
  employmentType String?

  experienceLevel String?

  requiredSkills  String[] @default([])
  preferredSkills String[] @default([])

  minExperienceYears Int?
  maxExperienceYears Int?

  status JobStatus @default(DRAFT)

  createdBy User @relation("JobOpeningCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  interviews Interview[]
  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("job_openings")
}

model JobApplication {
  id String @id @default(uuid()) @db.Uuid

  jobId String @db.Uuid
  candidateProfileId String @db.Uuid
  resumeId String @db.Uuid

  status JobApplicationStatus @default(APPLIED)

  coverLetter String? @db.Text

  job JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  interview Interview?

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, candidateProfileId])
  @@index([jobId])
  @@index([candidateProfileId])
  @@index([resumeId])
  @@index([status])
  @@index([appliedAt])
  @@map("job_applications")
}

model InterviewTemplate {
  id String @id @default(uuid()) @db.Uuid

  createdById String @db.Uuid

  name        String
  description String? @db.Text

  type       InterviewType
  difficulty InterviewDifficulty

  durationMinutes Int @default(45)
  questionCount   Int @default(10)

  includeResumeQuestions   Boolean @default(true)
  includeJobQuestions      Boolean @default(true)
  includeCodingQuestions   Boolean @default(false)
  adaptiveFollowUpsEnabled Boolean @default(false)

  maxFollowUpQuestions Int @default(3)

  systemPrompt String? @db.Text

  isActive Boolean @default(true)

  createdBy User @relation("InterviewTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  interviews Interview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([isActive])
  @@map("interview_templates")
}

model Interview {
  id String @id @default(uuid()) @db.Uuid

  candidateProfileId String @db.Uuid

  createdById String? @db.Uuid

  resumeId   String? @db.Uuid
  jobId      String? @db.Uuid
  templateId String? @db.Uuid
  applicationId String? @unique @db.Uuid

  title String

  type       InterviewType
  difficulty InterviewDifficulty

  status InterviewStatus @default(CREATED)

  durationMinutes Int @default(45)
  questionCount   Int @default(10)

  currentQuestionIndex Int @default(0)

  adaptiveFollowUpsEnabled Boolean @default(false)

  maxFollowUpQuestions Int @default(0)

  followUpCount Int @default(0)

  integrityScore Float @default(100)

  integrityWarningCount Int @default(0)

  lastHeartbeatAt DateTime?

  integrityEvents InterviewIntegrityEvent[]

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  overallScore Float?

  finalFeedback String? @db.Text

  evaluationData Json?

  processingError String? @db.Text

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  createdBy User? @relation("InterviewCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  job JobOpening? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  template InterviewTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  application JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  questions   InterviewQuestion[]
  invitations InterviewInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateProfileId])
  @@index([createdById])
  @@index([resumeId])
  @@index([jobId])
  @@index([templateId])
  @@index([applicationId])
  @@index([status])
  @@index([scheduledAt])
  @@map("interviews")
}

model InterviewQuestion {
  id String @id @default(uuid()) @db.Uuid

  interviewId String @db.Uuid

  order Int

  question String @db.Text

  type InterviewQuestionType @default(TEXT)

  source InterviewQuestionSource

  difficulty InterviewDifficulty

  section String?

  expectedTopics String[] @default([])

  referenceContext Json?

  maxScore Float @default(10)

  sequence Int?

  isFollowUp Boolean @default(false)

  parentQuestionId String? @db.Uuid

  parentQuestion InterviewQuestion? @relation("InterviewQuestionFollowUps", fields: [parentQuestionId], references: [id], onDelete: SetNull)

  followUps InterviewQuestion[] @relation("InterviewQuestionFollowUps")

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  answer InterviewAnswer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([interviewId, order])
  @@index([interviewId])
  @@index([source])
  @@index([type])
  @@index([interviewId, sequence])
  @@index([parentQuestionId])
  @@map("interview_questions")
}

model InterviewAnswer {
  id String @id @default(uuid()) @db.Uuid

  questionId String @unique @db.Uuid

  answerText String? @db.Text

  codeAnswer String? @db.Text

  programmingLanguage String?

  startedAt  DateTime?
  answeredAt DateTime?

  durationSeconds Int?

  score Float?

  aiFeedback String? @db.Text

  evaluationData Json?

  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
  @@map("interview_answers")
}

model InterviewInvitation {
  id String @id @default(uuid()) @db.Uuid

  interviewId String @db.Uuid

  invitedById     String @db.Uuid
  candidateUserId String @db.Uuid

  email String

  tokenHash String @unique

  status InterviewInvitationStatus @default(PENDING)

  sentAt     DateTime?
  openedAt   DateTime?
  acceptedAt DateTime?
  revokedAt  DateTime?

  expiresAt DateTime

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  invitedBy User @relation("InterviewInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  candidateUser User @relation("InterviewInvitationCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([interviewId])
  @@index([candidateUserId])
  @@index([invitedById])
  @@index([status])
  @@index([expiresAt])
  @@map("interview_invitations")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  type   NotificationType
  status NotificationStatus @default(PENDING)

  recipientEmail String

  subject String
  message String @db.Text

  metadata Json?

  providerMessageId String?

  attemptCount Int @default(0)

  processingError String? @db.Text

  sentAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model InterviewIntegrityEvent {
  id String @id @default(uuid()) @db.Uuid

  interviewId String @db.Uuid

  type InterviewIntegrityEventType

  severity InterviewIntegritySeverity

  metadata Json?

  occurredAt DateTime

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([interviewId])
  @@index([type])
  @@index([severity])
  @@index([occurredAt])
  @@map("interview_integrity_events")
}
